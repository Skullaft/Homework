CREATE OR REPLACE FUNCTION bookings.fn_select_flight(
    p_scheduled_departure timestamptz
) RETURNS refcursor LANGUAGE plpgsql AS $$
DECLARE v_cur refcursor;
BEGIN
    OPEN v_cur FOR SELECT flight_id, flight_no, scheduled_departure, scheduled_arrival,
                          departure_airport, arrival_airport, status, aircraft_code,
                          actual_departure, actual_arrival
                   FROM bookings.flights
                   WHERE scheduled_departure = p_scheduled_departure;
    RETURN v_cur;
END; $$;

CREATE OR REPLACE FUNCTION bookings.fn_select_flight(
    p_scheduled_departure timestamptz,
    p_operator char(1)
) RETURNS refcursor LANGUAGE plpgsql AS $$
DECLARE v_cur refcursor;
BEGIN
    IF p_operator = '>' THEN
        OPEN v_cur FOR SELECT flight_id, flight_no, scheduled_departure, scheduled_arrival,
                              departure_airport, arrival_airport, status, aircraft_code,
                              actual_departure, actual_arrival
                       FROM bookings.flights
                       WHERE scheduled_departure > p_scheduled_departure;
    ELSIF p_operator = '<' THEN
        OPEN v_cur FOR SELECT flight_id, flight_no, scheduled_departure, scheduled_arrival,
                              departure_airport, arrival_airport, status, aircraft_code,
                              actual_departure, actual_arrival
                       FROM bookings.flights
                       WHERE scheduled_departure < p_scheduled_departure;
    ELSE
        RAISE EXCEPTION 'operator must be > or <';
    END IF;
    RETURN v_cur;
END; $$;
