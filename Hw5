CREATE OR REPLACE FUNCTION bookings.fn_insert_bookings(
    p_book_ref char(6),
    p_book_date timestamp,
    p_total_amount numeric(10,2)
) RETURNS integer LANGUAGE plpgsql AS $$
BEGIN
    INSERT INTO bookings.bookings(book_ref, book_date, total_amount)
    VALUES (p_book_ref, p_book_date, p_total_amount);
    RETURN 1;
EXCEPTION WHEN OTHERS THEN
    RAISE NOTICE '%', SQLERRM;
    RETURN -1;
END; $$;

CREATE OR REPLACE FUNCTION bookings.fn_select_bookings(
    p_book_ref char(6)
) RETURNS refcursor LANGUAGE plpgsql AS $$
DECLARE v_cur refcursor;
BEGIN
    OPEN v_cur FOR SELECT book_ref, book_date, total_amount
                   FROM bookings.bookings WHERE book_ref = p_book_ref;
    RETURN v_cur;
END; $$;

CREATE OR REPLACE FUNCTION bookings.fn_update_bookings(
    p_book_ref char(6),
    p_book_date timestamp,
    p_total_amount numeric(10,2)
) RETURNS integer LANGUAGE plpgsql AS $$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM bookings.bookings WHERE book_ref = p_book_ref) THEN
        RETURN 0;
    END IF;
    DELETE FROM bookings.bookings WHERE book_ref = p_book_ref;
    INSERT INTO bookings.bookings(book_ref, book_date, total_amount)
    VALUES (p_book_ref, p_book_date, p_total_amount);
    RETURN 1;
EXCEPTION WHEN OTHERS THEN
    RAISE NOTICE '%', SQLERRM;
    RETURN -1;
END; $$;

